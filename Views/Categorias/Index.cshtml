@model List<TechStore.Models.Categoria>
@{
    ViewData["Title"] = "Categorías";
}

<div class="category-title mb-4 text-white rounded-3 hero-section py-3">
    <h1>Categorías</h1>
    <p class="text-ligth">Encuentra productos según lo que necesitas.</p>
</div>

<img class="componente-decorativo" src="~/Images/Componentes/descargam - copia.jpeg" alt="componente1" />


<div class="category-contenedor row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
    <div class="contedor-grid">
        @foreach (var categoria in Model)
        {
            <div class="col">
                <a asp-controller="Categorias" asp-action="Productos" asp-route-nombre="@categoria.Nombre" class="text-decoration-none text-dark">
                    <div class="card h-100 text-center shadow-sm category-card">
                        <div class="card-body">
                            <i class="bi @categoria.Icono display-4 text-primary"></i>
                            <h5 class="card-title mt-3">@categoria.Nombre</h5>
                            <p class="card-text text-muted small">@categoria.Descripcion</p>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
    <img class="imagen-stock" src="~/Images/Componentes/El texto del párrafo (2).jpg" alt="persona1"/> 
</div>

<br />
<br />
<br />
