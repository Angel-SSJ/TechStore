@model List<TechStore.Models.Producto>
@{
    ViewData["Title"] = "Inicio";
}

<div class="p-5 mb-4 bg-primary bg-gradient text-white rounded-3 hero-section">
    <div class="container-fluid py-4">
        <h1 class="display-5 fw-bold">Bienvenido a TechStore</h1>
        <p class="col-md-8 fs-5">
            Tu tienda de confianza en tecnología: laptops, smartphones, audio y accesorios
            al mejor precio, con la calidad que buscas.
        </p>
        <a asp-controller="Productos" asp-action="Index" class="btn btn-light btn-lg mt-2">
            <i class="bi bi-bag"></i> Ver productos
        </a>
    </div>
</div>

<div class="row text-center mb-5 g-3">
    <div class="col-6 col-md-3">
        <a asp-controller="Productos" asp-action="Index" class="text-decoration-none text-dark">
            <i class="bi bi-box-seam display-6 text-primary"></i>
            <p class="mt-2 fw-semibold">Productos</p>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a asp-controller="Categorias" asp-action="Index" class="text-decoration-none text-dark">
            <i class="bi bi-grid display-6 text-primary"></i>
            <p class="mt-2 fw-semibold">Categorías</p>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a asp-controller="Contacto" asp-action="Index" class="text-decoration-none text-dark">
            <i class="bi bi-envelope display-6 text-primary"></i>
            <p class="mt-2 fw-semibold">Contáctenos</p>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a asp-controller="Acerca" asp-action="Index" class="text-decoration-none text-dark">
            <i class="bi bi-info-circle display-6 text-primary"></i>
            <p class="mt-2 fw-semibold">Nosotros</p>
        </a>
    </div>
</div>

<div class="mb-4 d-flex justify-content-between align-items-center">
    <h2>Productos Destacados</h2>
    <a asp-controller="Productos" asp-action="Index" class="btn btn-outline-primary btn-sm">Ver todos</a>
</div>

<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
    @foreach (var producto in Model)
    {
        <div class="col">
            <partial name="_ProductCard" model="producto" />
        </div>
    }
</div>