@model List<TechStore.Models.Producto>
@{
    ViewData["Title"] = "Inicio";
}

<div class="contenedor-inicio mb-5 text-white rounded-3 hero-section">
    <div class="container-fluid py-5">
        <h1 class="display-5 fw-bold">Bienvenido a TechStore</h1>
        <p class="col-md-8 fs-5">
            Tu tienda de confianza en tecnología: laptops, smartphones, audio y accesorios
            al mejor precio, con la calidad que buscas.
        </p>
        <a asp-controller="Productos" asp-action="Index" class="btn btn-light btn-lg mt-2">
            <i class="bi bi-bag"></i> Ver productos
        </a>
    </div>
</div>

<img class="componente-decorativo" src="~/Images/Componentes/descargam - copia.jpeg" alt="componente1"/>

<hr />

<div class="iconos-inicio row text-center mb-5 g-3">
    <div class="col-6 col-md-3">
        <a asp-controller="Productos" asp-action="Index" class="text-decoration-none text-dark">
            <i class="bi bi-box-seam display-6 text-primary"></i>
            <p class="mt-2 fw-bolder">Productos</p>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a asp-controller="Categorias" asp-action="Index" class="text-decoration-none text-dark">
            <i class="bi bi-grid display-6 text-primary"></i>
            <p class="mt-2 fw-bolder">Categorías</p>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a asp-controller="Contacto" asp-action="Index" class="text-decoration-none text-dark">
            <i class="bi bi-envelope display-6 text-primary"></i>
            <p class="mt-2 fw-bolder">Contáctenos</p>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a asp-controller="Acerca" asp-action="Index" class="text-decoration-none text-dark">
            <i class="bi bi-info-circle display-6 text-primary"></i>
            <p class="mt-2 fw-bolder">Nosotros</p>
        </a>
    </div>
</div>

<hr />

<div class="productos-texto-inicio mb-4 d-flex justify-content-between text-primary align-items-center">
    <h2>Productos Destacados</h2>
    <a asp-controller="Productos" asp-action="Index" class="btn btn-outline-primary btn-sm">Ver todos</a>
</div>


<div class="productos-inicio row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
    @foreach (var producto in Model)
    {
        <div class="col">
            <partial name="_ProductCard" model="producto" />
        </div>
    }
</div>

<div id="carouselExample" class="carrusel-anuncio carousel slide">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="~/Images/Anuncios/AnuncioAudifonos.jpg" class="d-block w-100" alt="Anuncio1">
        </div>
        <div class="carousel-item">
            <img src="~/Images/Anuncios/AnuncioTeclado.jpg" class="d-block w-100" alt=Anuncio2>
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>