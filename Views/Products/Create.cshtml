@model TechStore.Models.Product

@{
    ViewData["Title"] = "Crear nuevo producto";
    var categories = ViewBag.Categories as IEnumerable<TechStore.Models.Category>;
}

<h1 class="mb-5">Crear nuevo producto</h1>

<form asp-action="Create" method="Post" enctype="multipart/form-data">
    <div class="row">
        <div class="col-md-12">
            <div class="mb-5">
                <label asp-for="Name">Nombre</label>
                <input asp-for="Name" class="form-control"/>
                <span asp-validation-for="Name"></span>
            </div>
            <div class="mb-5">
                <label asp-for="Description">Descripción</label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description"></span>
            </div>
            <div class="mb-5">
                <label asp-for="Price">Precio</label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price"></span>
            </div>
            <div class="mb-5">
                <label asp-for="Stock">Existencias</label>
                <input asp-for="Stock" class="form-control"/>
                <span asp-validation-for="Stock"></span>
            </div>

            <div class="form-check mb-5">
                <input asp-for="Featured" value="true" class="form-check-input" />
                <label asp-for="Featured" class="form-check-label">Destacado</label>
            </div>

            <div class="form-check mb-5">
                <input asp-for="IsActive" value="true" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Activo</label>
            </div>

            <div class="mb-5">
                <label>Categorías</label>
                <select name="selectedCategoryIds" multiple class="form-control">
                    @foreach (var cat in categories)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                </select>
            </div>

            <div class="mb-5">
                <label>Imágenes</label>
                <input type="file" name="images" multiple class="form-control" />
            </div>

            <div class="d-flex gap-2">
               <div class="mb-5">
                    <button type="submit" class="btn btn-success">Crear</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
               </div>
            </div>

        </div>
    </div>
</form>