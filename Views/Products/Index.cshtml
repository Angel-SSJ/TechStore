@model List<TechStore.Models.Product>

@{
    ViewData["Title"] = "Productos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Productos</h1>
        <p class="text-muted mb-0">
            Administración de productos de TechStore
        </p>
    </div>

    <a asp-controller="Products"
       asp-action="Create"
       class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>
        Nuevo producto
    </a>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        No hay productos registrados.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

        @foreach (var product in Model)
        {
            var primaryImage = product.Images.FirstOrDefault();

            <div class="col">
                <div class="card h-100 shadow-sm">

                    @if (primaryImage != null)
                    {
                        <img src="@Url.Content("~/" + primaryImage.ImagePath)"
                             class="card-img-top p-3"
                             alt="@product.Name"
                             style="height: 220px; object-fit: contain;" />
                    }
                    else
                    {
                        <div class="d-flex justify-content-center align-items-center bg-light"
                             style="height: 220px;">
                            <div class="text-center text-muted">
                                <i class="bi bi-image fs-1"></i>
                                <p class="mb-0">Sin imagen</p>
                            </div>
                        </div>
                    }

                    <div class="card-body d-flex flex-column">

                        <div class="mb-2">
                            @if (product.Categories.Any())
                            {
                                @foreach (var category in product.Categories)
                                {
                                    <span class="badge bg-secondary me-1">
                                        @category.Name
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="badge bg-light text-dark">
                                    Sin categoría
                                </span>
                            }
                        </div>

                        <h5 class="card-title">@product.Name</h5>

                        <p class="card-text text-muted small flex-grow-1">
                            @product.Description
                        </p>

                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold fs-5">
                                @product.Price.ToString("C2")
                            </span>

                            @if (product.IsActive)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactivo</span>
                            }
                        </div>

                        <div class="mb-3">
                            <small class="text-muted">
                                <i class="bi bi-box-seam"></i>
                                Stock: @product.Stock
                            </small>

                            @if (product.Featured)
                            {
                                <span class="badge bg-warning text-dark ms-2">
                                    <i class="bi bi-star-fill"></i>
                                    Destacado
                                </span>
                            }
                        </div>

                        <div class="d-grid gap-2">

                            <a asp-controller="Products"
                               asp-action="Details"
                               asp-route-id="@product.Id"
                               class="btn btn-outline-primary">
                                <i class="bi bi-eye"></i>
                                Ver detalles
                            </a>

                            <a asp-controller="Products"
                               asp-action="Edit"
                               asp-route-id="@product.Id"
                               class="btn btn-outline-secondary">
                                <i class="bi bi-pencil"></i>
                                Editar
                            </a>

                        </div>

                    </div>
                </div>
            </div>
        }

    </div>
}