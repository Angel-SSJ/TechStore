@model IEnumerable<TechStore.Models.Product>
@{
    ViewData["Title"] = "Listado de Productos";
}

<h1 class="Listado-libros">@ViewData["Title"]</h1>

<p>Hay @Model.Count() Productos disponibles.</p>

<a class="boton-libros btn btn-primary" asp-action="Create">Agregar producto</a>

<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
    @foreach (var producto in Model)
    {
        var primaryImage = producto.Images != null && producto.Images.Any()
        ? producto.Images.OrderBy(i => i.ImageNumber).First()
        : null;

        <div class="tarjeta-libro card h-100 shadow-sm product-car">
            <div class="card-body d-flex flex-column">
                @if (primaryImage != null)
                {
                    <img src="@Url.Content("~/Images/Products/" + primaryImage.ImagePath)" alt="@producto.Name" />
                }
                <h5 class="card-title text-center">@producto.Name</h5>
                <p class="card-text text-muted small flex-grow-1">Descripción: @producto.Description</p>
                <p class="card-text text-muted small flex-grow-1">Precio: @producto.Price</p>
                <a asp-action="Details" class="btn btn-secondary" asp-route-id="@producto.Id">Ver</a>
            </div>
        </div>
    }
</div>