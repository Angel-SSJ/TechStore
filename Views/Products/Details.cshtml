@model TechStore.Models.Product

@{
    ViewData["Title"] = "Detalles del Producto";

    var primaryImage = Model.Images != null && Model.Images.Any()
        ? Model.Images.OrderBy(i => i.ImageNumber).First()
        : null;
}

<h1>Detalles del producto</h1>

<div class="row">

    <div class="col-md-5 mb-4">

        @if (primaryImage != null)
        {
            <img src="/@primaryImage.ImagePath"
                 alt="@Model.Name"
                 class="img-fluid"
                 style="width: 100%; max-height: 400px; object-fit: contain;" />
        }
        else
        {
            <div class="alert alert-secondary">
                Este producto no tiene imagen.
            </div>
        }

    </div>

    <div class="col-md-7">

        <h3>@Model.Name</h3>

        <p class="text-muted">
            @Model.Description
        </p>

        <dl class="row">

            <dt class="col-sm-4">
                Precio
            </dt>

            <dd class="col-sm-8">
                @Model.Price.ToString("C2")
            </dd>

            <dt class="col-sm-4">
                Stock
            </dt>

            <dd class="col-sm-8">
                @Model.Stock
            </dd>

            <dt class="col-sm-4">
                Destacado
            </dt>

            <dd class="col-sm-8">
                @(Model.Featured ? "Sí" : "No")
            </dd>

            <dt class="col-sm-4">
                Estado
            </dt>

            <dd class="col-sm-8">

                @if (Model.IsActive)
                {
                    <span class="badge bg-success">
                        Activo
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">
                        Inactivo
                    </span>
                }

            </dd>

            <dt class="col-sm-4">
                Categorías
            </dt>

            <dd class="col-sm-8">

                @if (Model.Categories != null && Model.Categories.Any())
                {
                    @foreach (var cat in Model.Categories)
                    {
                        <span class="badge bg-primary me-1">
                            @cat.Name
                        </span>
                    }
                }
                else
                {
                    <span class="text-muted">
                        Sin categorías
                    </span>
                }

            </dd>

        </dl>

    </div>

</div>

<div class="d-flex gap-3 mt-3">

    <a class="btn btn-primary"
       asp-action="Edit"
       asp-route-id="@Model.Id">
        Editar
    </a>

    <a class="btn btn-secondary"
       asp-action="Index">
        Volver
    </a>

    @if (Model.IsActive)
    {
        <form asp-action="Deactivate"
              method="post"
              asp-route-id="@Model.Id"
              class="d-inline">

            <button type="submit"
                    class="btn btn-danger">
                Desactivar
            </button>

        </form>
    }
    else
    {
        <form asp-action="Restore"
              method="post"
              asp-route-id="@Model.Id"
              class="d-inline">

            <button type="submit"
                    class="btn btn-success">
                Reactivar
            </button>

        </form>
    }

</div>