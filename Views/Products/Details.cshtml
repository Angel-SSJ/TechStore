@model TechStore.Models.Product

@{
    ViewData["Title"] = "Detalles del Producto";

    var primaryImage = Model.Images != null && Model.Images.Any()
        ? Model.Images.OrderBy(i => i.ImageNumber).First()
        : null;
}

<div class="titulo-nuevo mb-4 text-white rounded-3 hero-section py-3">
    <h1>Detalles del producto</h1>
</div>

<div class="row">

    <div class="col-md-5 mb-4">

        @if (primaryImage != null)
        {
            <img src="/@primaryImage.ImagePath"
                 alt="@Model.Name"
                 class="img-fluid"
                 style="width: 100%; max-height: 400px; object-fit: contain;" />
        }
        else
        {
            <div class="alert alert-secondary">
                Este producto no tiene imagen.
            </div>
        }

    </div>

    <div class="col-md-7">

        <div class="card">

            <div class="card-body shadow-sm">

                <h3 style="color: midnightblue;"
                    class="fw-bold text-uppercase">
                    @Model.Name
                </h3>

                <p class="text-muted">
                    @Model.Description
                </p>

                <dl class="row">

                    <dt class="col-sm-4">
                        Precio
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Price.ToString("C2")
                    </dd>

                    <dt class="col-sm-4">
                        Stock
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Stock
                    </dd>

                    <dt class="col-sm-4">
                        Destacado
                    </dt>

                    <dd class="col-sm-8">
                        @(Model.Featured ? "Sí" : "No")
                    </dd>

                    <dt class="col-sm-4">
                        Estado
                    </dt>

                    <dd class="col-sm-8">

                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">
                                Activo
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Inactivo
                            </span>
                        }

                    </dd>

                    <dt class="col-sm-4">
                        Categorías
                    </dt>

                    <dd class="col-sm-8">

                        @if (Model.Categories != null &&
                             Model.Categories.Any())
                        {
                            @foreach (var cat in Model.Categories)
                            {
                                <span class="badge bg-primary me-1">
                                    @cat.Name
                                </span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">
                                Sin categorías
                            </span>
                        }

                    </dd>

                </dl>

            </div>

        </div>

    </div>

</div>

<div class="d-flex gap-3 mt-3 flex-wrap">

    <a class="btn btn-primary"
       asp-action="Edit"
       asp-route-id="@Model.Id">
        Editar
    </a>

    <a class="btn btn-outline-primary"
       asp-action="Index">
        Volver
    </a>

    @if (Model.IsActive)
    {
        <form asp-action="Deactivate"
              method="post"
              asp-route-id="@Model.Id"
              class="d-inline swal-delete-form">

            <button type="submit"
                    class="btn btn-danger">

                <i class="bi bi-x-circle me-1"></i>
                Desactivar

            </button>

        </form>
    }
    else
    {
        <form asp-action="Restore"
              method="post"
              asp-route-id="@Model.Id"
              class="d-inline">

            <button type="submit"
                    class="btn btn-success">

                <i class="bi bi-arrow-counterclockwise me-1"></i>
                Reactivar

            </button>

        </form>
    }

</div>