@model TechStore.Models.Product
@{
    ViewData["Title"] = "Detalles del Producto";
    var primaryImage = Model.Images != null && Model.Images.Any()
    ? Model.Images.OrderBy(i => i.ImageNumber).First()
    : null;
}

<h1>Detalles del producto</h1>

<div class="row">
    @if (primaryImage != null)
    {
        <img src="@Url.Content("~/Images/Products/" + primaryImage.ImagePath)" alt="@Model.Name" />
    }

    <div class="col-md-7">
        <h3>@Model.Name</h3>
        <p class="text-muted">@Model.Description</p>

        <dl class="row">
            <dt class="col-sm-4">Precio</dt>
            <dd class="col-sm-8">@Model.Price</dd>

            <dt class="col-sm-4">Existencias</dt>
            <dd class="col-sm-8">@Model.Stock</dd>

            <dt class="col-sm-4">Destacado</dt>
            <dd class="col-sm-8">@Model.Featured</dd>

            <dt class="col-sm-4">Activo</dt>
            <dd class="col-sm-8">@Model.IsActive</dd>

            <dt class="col-sm-4">Categorías</dt>
            <dd class="col-sm-8">
                @foreach (var cat in Model.Categories)
                {
                    <span>@cat.Name </span>
                }
            </dd>
        </dl>
    </div>
</div>

<div class="d-flex gap-3">
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
    <a class="btn btn-secondary" asp-action="Index">Volver</a>

    @if (Model.IsActive)
    {
        <form asp-action="Deactivate" method="post" asp-route-id="@Model.Id" class="d-inline">
            <button type="submit" class="btn btn-danger">Desactivar</button>
        </form>
    }
    else
    {
        <form asp-action="Restore" method="post" asp-route-id="@Model.Id" class="d-inline">
            <button type="submit" class="btn btn-secondary">Reactivar</button>
        </form>
    }
</div>
