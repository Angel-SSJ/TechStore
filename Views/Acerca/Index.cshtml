@{
    ViewData["Title"] = "Acerca de nosotros";
}

<h1 class="mb-4">Acerca de nosotros</h1>

<section class="mb-5">
    <h2>Nuestra Historia</h2>
    <p>
        TechStore nació con la idea de acercar la tecnología a todas las personas, ofreciendo productos
        de calidad a precios justos. Desde nuestros inicios como un pequeño emprendimiento, hemos crecido
        gracias a la confianza de nuestros clientes y al compromiso de nuestro equipo.
    </p>
</section>

<div class="row g-4 mb-5">
    <div class="col-md-6">
        <div class="card h-100 border-0 bg-light">
            <div class="card-body">
                <h2 class="h4"><i class="bi bi-bullseye text-primary"></i> Misión</h2>
                <p class="card-text">
                    Ofrecer productos tecnológicos de calidad, con un servicio cercano y confiable,
                    ayudando a nuestros clientes a mantenerse conectados con las últimas tendencias.
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100 border-0 bg-light">
            <div class="card-body">
                <h2 class="h4"><i class="bi bi-eye text-primary"></i> Visión</h2>
                <p class="card-text">
                    Ser la tienda de tecnología de referencia a nivel nacional, reconocida por su innovación,
                    calidad de servicio y compromiso con sus clientes.
                </p>
            </div>
        </div>
    </div>
</div>

<section>
    <h2 class="mb-3">Nuestros Valores</h2>
    <div class="row row-cols-2 row-cols-md-4 g-3 text-center">
        <div class="col">
            <i class="bi bi-shield-check display-6 text-primary"></i>
            <p class="mt-2 mb-0 fw-semibold">Confianza</p>
        </div>
        <div class="col">
            <i class="bi bi-lightning-charge display-6 text-primary"></i>
            <p class="mt-2 mb-0 fw-semibold">Innovación</p>
        </div>
        <div class="col">
            <i class="bi bi-people display-6 text-primary"></i>
            <p class="mt-2 mb-0 fw-semibold">Cercanía</p>
        </div>
        <div class="col">
            <i class="bi bi-award display-6 text-primary"></i>
            <p class="mt-2 mb-0 fw-semibold">Calidad</p>
        </div>
    </div>
</section>