@model TechStore.Models.Category

@{
    ViewData["Title"] = "Detalles de la categoría";

    var producto = ViewBag.Products as IEnumerable<TechStore.Models.Product>
        ?? Enumerable.Empty<TechStore.Models.Product>();
}

<div class="titulo-nuevo mb-4 text-white rounded-3 hero-section py-3">

    <h1>
        Detalles de la categoría
    </h1>

</div>

<div class="row">

    <div class="col-md-12">

        <div class="card">

            <div class="card-body shadow-sm">

                <h3 style="color: midnightblue;"
                    class="fw-bold text-uppercase">

                    @Model.Name

                </h3>

                <p class="text-muted">
                    @Model.Description
                </p>

                <dl class="row">

                    @if (Model.IsActive)
                    {
                        <dt class="col-sm-4">
                            Activo
                        </dt>

                        <dd class="col-sm-8 fw-bold"
                            style="color:dodgerblue;">
                            @Model.IsActive
                        </dd>
                    }
                    else
                    {
                        <dt class="col-sm-4">
                            Activo
                        </dt>

                        <dd class="col-sm-8 fw-bold"
                            style="color:slategrey;">
                            @Model.IsActive
                        </dd>
                    }

                    <dt class="col-sm-4">
                        Productos
                    </dt>

                    <dd class="col-sm-8 fw-semibold">
                        @Model.Products.Count
                    </dd>

                    <dt class="col-sm-4">
                        Fecha de creación
                    </dt>

                    <dd class="col-sm-8 fw-semibold">
                        @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                    </dd>

                </dl>

            </div>

        </div>

    </div>

</div>

<h4 class="mt-4"
    style="color: midnightblue; margin-bottom:15px;">

    Productos de la categoría

</h4>

@if (Model.Products.Any())
{
    <div class="list-group mb-4">

        @foreach (var product in Model.Products)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">

                <div>

                    <i class="bi bi-box-seam me-2 text-primary"></i>

                    <strong>
                        @product.Name
                    </strong>

                </div>

                <a asp-controller="Products"
                   asp-action="Details"
                   asp-route-id="@product.Id"
                   class="btn btn-outline-primary btn-sm">

                    Ver producto

                    <i class="bi bi-arrow-right ms-1"></i>

                </a>

            </div>
        }

    </div>
}
else
{
    <div class="alert alert-secondary">

        <i class="bi bi-info-circle me-1"></i>

        Esta categoría aún no tiene productos asociados.

    </div>
}

<div class="d-flex gap-3 flex-wrap">

    <a class="btn btn-primary"
       asp-action="Edit"
       asp-route-id="@Model.Id">

        Editar

    </a>

    <a class="btn btn-secondary"
       asp-action="Index">

        Volver

    </a>

    @if (Model.IsActive)
    {
        <form asp-action="Deactivate"
              method="post"
              asp-route-id="@Model.Id"
              class="d-inline swal-delete-form">

            <button type="submit"
                    class="btn btn-danger">

                <i class="bi bi-x-circle me-1"></i>
                Desactivar

            </button>

        </form>
    }
    else
    {
        <form asp-action="Restore"
              method="post"
              asp-route-id="@Model.Id"
              class="d-inline">

            <button type="submit"
                    class="btn btn-success">

                <i class="bi bi-arrow-counterclockwise me-1"></i>
                Reactivar

            </button>

        </form>
    }

</div>