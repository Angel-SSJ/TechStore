@model TechStore.Models.Category

@{
    ViewData["Title"] = "Editar categoría";
    var products = ViewBag.Products as IEnumerable<TechStore.Models.Product> ?? Enumerable.Empty<TechStore.Models.Product>();
}

<div class="titulo-nuevo mb-4 text-white rounded-3 hero-section py-3">
    <h1>Editar categoría</h1>
</div>

@if (TempData["CategorySuccess"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["CategorySuccess"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (TempData["CategoryError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["CategoryError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <div class="row">
        <div class="col-md-12">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

            <div class="mb-5">
                <label asp-for="Name">Nombre</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name"></span>
            </div>

            <div class="mb-5">
                <label asp-for="Description">Descripción</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description"></span>
            </div>

            <div class="form-check mb-5">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Activo</label>
            </div>

            <div class="mb-5">
                <label>Productos</label>
                <select name="selectedProductIds" multiple class="form-control">
                    @foreach (var product in products)
                    {
                        var selected = Model.Products.Any(categoryProduct => categoryProduct.Id == product.Id);
                        <option value="@product.Id" selected="@selected">@product.Name</option>
                    }
                </select>
            </div>

            <div class="d-flex gap-2">
                <div class="mb-5">
                    <button type="submit" class="btn btn-success">Guardar cambios</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
